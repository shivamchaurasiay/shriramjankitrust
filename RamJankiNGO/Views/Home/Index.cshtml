                            int progress = target > 0 ? (int)Math.Min(100, Math.Round((raised / target) * 100)) : 0;
                            string img = !string.IsNullOrEmpty(row["ImagePath"]?.ToString()) ? row["ImagePath"].ToString()! : "/assets/img/donation-1.jpg";
                            int campId = Convert.ToInt32(row["CampaignId"]);
