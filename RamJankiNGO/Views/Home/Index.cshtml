                                            <div class="ul-blog-info">
                                                <span class="icon"><i class="flaticon-price-tag"></i></span>
                                                <span>@bCat</span>
                                            </div>
                                        </div>
                                        <h4 class="ul-blog-title mb-3" style="font-size: 1.1rem; line-height: 1.4;">
                                            <a href="/Home/EventDetails/@blogId" class="text-dark text-decoration-none">@bTitle</a>
                                        </h4>
                                        <div class="mt-auto">
                                            <a href="/Home/EventDetails/@blogId" class="ul-blog-btn text-decoration-none fw-semibold" style="color: #e85a2a;">Read More <span class="icon"><i class="flaticon-next"></i></span></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
        <!-- BLOG SECTION END -->
    </main>






