                                            <div>
                                                <span class="text-muted">Raised :</span>
                                                <span class="fw-bold text-dark">&#8377;@raised.ToString("N0")</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Goal :</span>
                                                <span class="fw-bold text-dark">&#8377;@target.ToString("N0")</span>
                                            </div>
                                        </div>

                                        <!-- Title & Short Description -->
                                        <h5 class="card-title fw-bold mb-2" style="font-size: 1.1rem; line-height: 1.4;">
                                            <a href="/Home/Donation?campaignId=@campId" class="text-dark text-decoration-none">
                                                @title
                                            </a>
                                        </h5>
                                        <p class="card-text text-muted small flex-grow-1 mb-4" style="line-height: 1.6;">
                                            @(row["ShortDescription"]?.ToString() ?? "Join hands in supporting this sacred welfare initiative.")
                                        </p>

                                        <!-- Donate Now Button with arrow -->
                                        <div class="mt-auto">
                                            <a href="/Home/Donation?campaignId=@campId" class="btn w-100 py-2 fw-semibold rounded-3 text-white d-flex align-items-center justify-content-center gap-2 text-decoration-none"
                                               style="background-color: #e85a2a; border-color: #e85a2a; font-size: 0.95rem;">
                                                <span>Donate now</span>
                                                <span style="font-size: 1.1rem; line-height: 1;">&nearr;</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </section>
