
<main>
    <!-- BREADCRUMBS SECTION START -->
    <section class="ul-breadcrumb ul-section-spacing">
        <div class="ul-container">
            <h2 class="ul-breadcrumb-title">About Us</h2>
            <ul class="ul-breadcrumb-nav">
                <li><a href="/">Home</a></li>
                <li><span class="separator"><i class="flaticon-right"></i></span></li>
                <li>About Us</li>
            </ul>
        </div>
    </section>
    <!-- BREADCRUMBS SECTION END -->
    <!-- ABOUT SECTION START -->
    <section class="ul-about ul-section-spacing wow animate__fadeInUp">
        <div class="ul-container">
            <div class="row row-cols-md-2 row-cols-1 align-items-center gy-4 ul-about-row">
                <div class="col">
                    <div class="ul-about-imgs">
                        <div class="img-wrapper">
                            <img src="~/assets/img/about-img.png" alt="Shriram Janki Trust Community Service">
                        </div>
                        <div class="ul-about-imgs-vectors">
                            <img src="~/assets/img/about-img-vector-1.svg" alt="Vector" class="vector-1">
                            <img src="~/assets/img/about-img-vector-2.svg" alt="Vector" class="vector-2">
                        </div>
                    </div>
                </div>

                <!-- txt -->
                <div class="col">
                    <div class="ul-about-txt">
                        <span class="ul-section-sub-title ul-section-sub-title--2">About Shriram Janki Trust</span>
                        <h2 class="ul-section-title">Dedicated to Uplifting Lives and Spreading Compassion</h2>
                        <p class="ul-section-descr">Shriram Janki Trust is a charitable organization driven by the values of selfless service, devotion, and community welfare. We work relentlessly to support underprivileged sections through education, health drives, and humanitarian relief.</p>

                        <div class="ul-about-block">
                            <div class="block-left">
                                <div class="block-heading">
                                    <div class="icon"><i class="flaticon-love"></i></div>
                                    <h3 class="block-title">Our Social Mission</h3>
                                </div>

                                <ul class="block-list">
                                    <li>Empowering communities with basic resources</li>
                                </ul>
                            </div>
                            <div class="block-right"><img src="~/assets/img/about-block-img.jpg" alt="Trust Activities"></div>
                        </div>

                        <div class="ul-about-bottom">
                            <a href="/Home/AboutUs" class="ul-btn"><i class="flaticon-fast-forward-double-right-arrows-symbol"></i> Explore More</a>

                            <div class="ul-about-call">
                                <div class="icon"><i class="flaticon-telephone-call"></i></div>
                                <div class="txt">
                                    <span class="call-title">Call Any Time</span>
                                    <a href="tel:+919918953452">+91 9918953452</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- vector -->
        <div class="ul-about-vectors">
            <img src="~/assets/img/about-vector-1.png" alt="vector" class="vector-1">
        </div>
    </section>
    <!-- ABOUT SECTION END -->
    <!-- STATS SECTION START -->
    <div class="ul-stats ul-section-spacing">
        <div class="ul-container">
            <div class="ul-stats-wrapper wow animate__fadeInUp">
                <div class="row row-cols-md-4 row-cols-sm-3 row-cols-2 row-cols-xxs-1 ul-bs-row justify-content-center">
                    <div class="col">
                        <div class="ul-stats-item">
                            <i class="flaticon-costumer"></i>
                            <span class="number">260+</span>
                            <span class="txt">Children Supported</span>
                        </div>
                    </div>

                    <div class="col">
                        <div class="ul-stats-item">
                            <i class="flaticon-team"></i>
                            <span class="number">110+</span>
                            <span class="txt">Dedicated Volunteers</span>
                        </div>
                    </div>

                    <div class="col">
                        <div class="ul-stats-item">
                            <i class="flaticon-package"></i>
                            <span class="number">190+</span>
                            <span class="txt">Welfare Programs</span>
                        </div>
                    </div>

                    <div class="col">
                        <div class="ul-stats-item">
                            <i class="flaticon-relationship"></i>
                            <span class="number">560+</span>
                            <span class="txt">Worldwide Donors</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- STATS SECTION END -->
    <!-- MISSION, VISION, HISTORY SECTION START -->
    <section id="mission" class="ul-about-tabs ul-events ul-section-spacing pt-0">
        <div class="ul-container">
            <!-- heading -->
            <div class="ul-section-heading align-items-center wow animate__fadeInUp">
                <div class="left">
                    <span class="ul-section-sub-title">Our Organization Background</span>
                    <h2 class="ul-section-title text-white">Guiding Principles and Legacy of the Trust</h2>
                </div>
                <a href="/Home/Donation" class="ul-btn"><i class="flaticon-fast-forward-double-right-arrows-symbol"></i> Donate Now</a>
            </div>

            <!-- tab group -->
            <div class="tab-group">
                <!-- tabs -->
                <div class="ul-about-tabs-wrapper">
                    <div id="tab-mission" class="ul-tab ul-about-tab active">
                        <div class="ul-about-tab-img">
                            <img src="~/assets/img/mission-img.jpg" alt="Mission">
                        </div>

                        <div class="ul-about-tab-txt">
                            <h3 class="ul-about-tab-title">Our Core Mission</h3>
                            <p class="ul-about-tab-descr">To foster an inclusive society by delivering essential welfare support, facilitating educational opportunities for children, and ensuring healthcare access for the marginalized sections of society.</p>
                            <ul class="ul-about-tab-list">
                                <li>Promoting moral and value-based education for children.</li>
                                <li>Organizing free medical checkup camps in rural areas.</li>
                                <li>Providing food, clothing, and essential kits to the needy.</li>
                                <li>Creating awareness about social harmony and community care.</li>
                            </ul>
                            <p class="ul-about-tab-descr">We believe that collective compassion can transform society and bring long-lasting positive changes to the lives of underprivileged families.</p>
                        </div>
                    </div>

                    <!-- tab 02 / vision -->
                    <div id="tab-vision" class="ul-tab ul-about-tab">
                        <div class="ul-about-tab-img">
                            <img src="~/assets/img/why-join.jpg" alt="Vision">
                        </div>

                        <div class="ul-about-tab-txt">
                            <h3 class="ul-about-tab-title">Our Long-term Vision</h3>
                            <p class="ul-about-tab-descr">To build a self-sustaining, compassionate community where no individual is deprived of basic human dignity, education, and healthcare.</p>
                            <ul class="ul-about-tab-list">
                                <li>Establish holistic development centers across rural sectors.</li>
                                <li>Support higher education pathways for deserving students.</li>
                                <li>Empower women through vocational skill training programs.</li>
                                <li>Foster unity, peace, and mutual support through humanitarian initiatives.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- tab 03 / history -->
                    <div id="tab-history" class="ul-tab ul-about-tab">
                        <div class="ul-about-tab-img">
                            <img src="~/assets/img/contact-img.jpg" alt="History">
                        </div>

                        <div class="ul-about-tab-txt">
                            <h3 class="ul-about-tab-title">Our Journey & History</h3>
                            <p class="ul-about-tab-descr">Shriram Janki Trust was established with a vision to serve humanity selflessly. Inspired by cultural values and timeless ideals of service, a small group of philanthropic individuals came together to build a platform for social change.</p>
                            <p class="ul-about-tab-descr">Over the years, the trust has grown from localized community assistance into a structured welfare organization, touching hundreds of lives through continuous donation drives, medical camps, and educational aid.</p>
                            <p class="ul-about-tab-descr">With the unwavering support of our volunteers and donors, we continue to expand our reach, addressing critical challenges faced by society today.</p>
                        </div>
                    </div>
                </div>

                <div class="tab-navs ul-about-tabs-nav">
                    <button class="tab-nav active" data-tab="tab-mission"> Our Mission </button>
                    <button class="tab-nav" data-tab="tab-vision">Our Vision</button>
                    <button class="tab-nav" data-tab="tab-history">Our History</button>
                </div>
            </div>

            <!-- vectors -->
            <div class="ul-events-vectors">
                <img src="~/assets/img/events-vector-2.svg" alt="Vector" class="vector-2">
            </div>
        </div>
    </section>
    <!-- MISSION, VISION, HISTORY SECTION END -->
    <!-- TEAM SECTION START -->
    <section id="team" class="ul-team ul-section-spacing">
        <div class="ul-container">
            <!-- Heading -->
            <div class="ul-section-heading justify-content-between">
                <div class="left">
                    <span class="ul-section-sub-title">Trust Leadership</span>
                    <h2 class="ul-section-title">Dedicated Trustees & Core Members</h2>
                </div>
                <div>
                    <a href="/Home/ContactUs" class="ul-btn"><i class="flaticon-fast-forward-double-right-arrows-symbol"></i> Join With Us</a>
                </div>
            </div>

            <div class="row row-cols-md-4 row-cols-sm-3 row-cols-2 row-cols-xxs-1 ul-team-row justify-content-center">
                @if (ViewBag.Team != null && ((System.Data.DataTable)ViewBag.Team).Rows.Count > 0)
                {
                    foreach (System.Data.DataRow team in ((System.Data.DataTable)ViewBag.Team).Rows)
                    {
                        string tImg = !string.IsNullOrEmpty(team["ImagePath"]?.ToString()) ? team["ImagePath"].ToString()! : "/assets/img/member-1.jpg";
                        string tName = team["Name"]?.ToString() ?? "";
                        string tRole = team["Designation"]?.ToString() ?? "Trust Member";
                        string fb = team.Table.Columns.Contains("FacebookUrl") && team["FacebookUrl"] != DBNull.Value ? team["FacebookUrl"].ToString()! : "#";
                        string tw = team.Table.Columns.Contains("TwitterUrl") && team["TwitterUrl"] != DBNull.Value ? team["TwitterUrl"].ToString()! : "#";
                        string ln = team.Table.Columns.Contains("LinkedInUrl") && team["LinkedInUrl"] != DBNull.Value ? team["LinkedInUrl"].ToString()! : "#";

                        <div class="col">
                            <div class="ul-team-member h-100 rounded-4 overflow-hidden shadow-sm" style="background:#fff; border: 1px solid #f0e6dd;">
                                <div class="ul-team-member-img position-relative" style="height: 280px; overflow:hidden;">
                                    <img src="@Url.Content(tImg)" alt="@tName" style="width:100%; height:100%; object-fit: cover;">
                                    <div class="ul-team-member-socials">
                                        <a href="@fb"><i class="flaticon-facebook"></i></a>
                                        <a href="@tw"><i class="flaticon-twitter"></i></a>
                                        <a href="@ln"><i class="flaticon-linkedin-big-logo"></i></a>
                                    </div>
                                </div>
                                <div class="ul-team-member-info p-3 text-center">
                                    <h3 class="ul-team-member-name mb-1" style="font-size: 1.15rem; font-weight: 600;">@tName</h3>
                                    <p class="ul-team-member-designation text-muted small mb-0">@tRole</p>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
    <!-- TEAM SECTION END -->
    <!-- CTA SECTION START -->
    <section class="ul-cta">
        <div class="ul-container">
            <span class="ul-section-sub-title">Support Our Cause</span>
            <h2 class="ul-cta-title">Help Us Bring Smiles to Children in Need Today</h2>
            <a href="/Home/Donation" class="ul-btn"><i class="flaticon-fast-forward-double-right-arrows-symbol"></i> Make a Donation</a>
        </div>
        <img src="~/assets/img/cta-vector.svg" alt="Vector" class="ul-cta-vector">
    </section>
    <!-- CTA SECTION END -->
    <!-- TESTIMONIAL SECTION START -->
    <section class="ul-testimonial-2 ul-section-spacing">
        <div class="ul-container wow animate__fadeInUp">
            <div class="ul-section-heading">
                <div>
                    <span class="ul-section-sub-title">Donor & Volunteer Experiences</span>
                    <h2 class="ul-section-title">What People Say About Our Trust</h2>
                </div>
                <a href="/Home/ContactUs" class="ul-btn"><i class="flaticon-fast-forward-double-right-arrows-symbol"></i> Contact Us</a>
            </div>

            <div class="row ul-testimonial-2-row gy-4">
                <!-- card -->
                <div class="col-md-4">
                    <div class="ul-testimonial-2-overview">
                        <span class="rating">4.9</span>
                        <div class="ul-testimonial-2-overview-stars">
                            <i class="flaticon-star"></i>
                            <i class="flaticon-star"></i>
                            <i class="flaticon-star"></i>
                            <i class="flaticon-star"></i>
                            <i class="flaticon-star-1"></i>
                        </div>
                        <span class="ul-testimonial-2-overview-title">5 Star Rating</span>
                        <p class="ul-testimonial-2-overview-descr">Transparent welfare work and dedicated service make Shriram Janki Trust a truly trusted organization for community development.</p>
                        <div class="ul-testimonial-2-overview-reviewers">
                            <img src="~/assets/img/reviewer-1.png" alt="Reviewer">
                            <img src="~/assets/img/reviewer-2.png" alt="Reviewer">
                            <img src="~/assets/img/reviewer-3.png" alt="Reviewer">
                            <img src="~/assets/img/reviewer-4.png" alt="Reviewer">
                        </div>
                    </div>
                </div>

                <!-- txt -->
                <div class="col-md-8">
                    <div class="ul-testimonial-2-slider swiper">
                        <div class="swiper-wrapper">
                            <!-- single slide 1 -->
                            <div class="swiper-slide">
                                <div class="ul-review ul-review-2">
                                    <span class="icon"><i class="flaticon-quote-1"></i></span>
                                    <p class="ul-review-descr">"Participating in the educational drives organized by Shriram Janki Trust has been deeply fulfilling. Seeing the children receive books and proper guidance gives immense satisfaction."</p>
                                    <div class="ul-review-bottom">
                                        <div class="ul-review-reviewer">
                                            <div class="reviewer-image"><img src="~/assets/img/reviewer-1.png" alt="reviewer image"></div>
                                            <div>
                                                <h3 class="reviewer-name">Dr. Rakesh Verma</h3>
                                                <span class="reviewer-role">Trust Donor & Supporter</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- single slide 2 -->
                            <div class="swiper-slide">
                                <div class="ul-review ul-review-2">
                                    <span class="icon"><i class="flaticon-quote-1"></i></span>
                                    <p class="ul-review-descr">"The trust's commitment to organizing medical camps in rural areas is commendable. Their team handles every initiative with utmost honesty and compassion."</p>
                                    <div class="ul-review-bottom">
                                        <div class="ul-review-reviewer">
                                            <div class="reviewer-image"><img src="~/assets/img/reviewer-2.png" alt="reviewer image"></div>
                                            <div>
                                                <h3 class="reviewer-name">Anjali Tiwari</h3>
                                                <span class="reviewer-role">Active Volunteer</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ul-testimonial-2-slider-nav">
                            <button class="prev"><i class="flaticon-back"></i></button>
                            <button class="next"><i class="flaticon-next"></i></button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
    <!-- TESTIMONIAL SECTION END -->
</main>