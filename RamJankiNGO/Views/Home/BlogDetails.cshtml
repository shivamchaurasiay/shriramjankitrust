@using System.Data
@model DataRow
@{
    ViewData["Title"] = Model != null ? Model["Title"].ToString() : "Article Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recentBlogs = ViewBag.RecentBlogs as DataTable;
    var causes = ViewBag.ActiveCauses as DataTable;
    string img = Model != null && !string.IsNullOrEmpty(Model["ImagePath"]?.ToString()) ? Model["ImagePath"].ToString()! : "/assets/img/blog-details-img.jpg";
    DateTime dtCreated = Model != null && Model["CreatedAt"] != DBNull.Value ? Convert.ToDateTime(Model["CreatedAt"]) : DateTime.Now;
}

<main>
    <!-- BREADCRUMBS SECTION START -->
    <section class="ul-breadcrumb ul-section-spacing">
        <div class="ul-container">
            <h2 class="ul-breadcrumb-title">News &amp; Article Details</h2>
            <ul class="ul-breadcrumb-nav">
                <li><a href="/">Home</a></li>
                <li><span class="separator"><i class="flaticon-right"></i></span></li>
                <li><a href="/Home/Event">News &amp; Events</a></li>
                <li><span class="separator"><i class="flaticon-right"></i></span></li>
                <li class="text-truncate" style="max-width: 250px;">@(Model != null ? Model["Title"] : "")</li>
            </ul>
        </div>
    </section>
    <!-- BREADCRUMBS SECTION END -->

    <!-- DETAILS SECTION START -->
    <section class="ul-section-spacing py-5">
        <div class="ul-container">
            <div class="row g-5">
                <!-- Main Content -->
                <div class="col-lg-8">
                    @if (Model != null)
                    {
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden p-4 p-md-5 bg-white">
                            <div class="mb-3 d-flex align-items-center gap-3 flex-wrap">
                                <span class="badge px-3 py-2 rounded-pill text-white" style="background-color: #e85a2a; font-weight: 600;">
                                    @(Model["Category"]?.ToString() ?? "Seva Initiative")
                                </span>
                                <span class="text-muted small"><i class="fa fa-calendar-alt me-1 text-danger"></i> @dtCreated.ToString("dd MMMM, yyyy")</span>
                                <span class="text-muted small"><i class="fa fa-user me-1 text-danger"></i> By @(Model["Author"]?.ToString() ?? "Trust Admin")</span>
                            </div>

                            <h1 class="fw-bold mb-4" style="font-size: 2rem; line-height: 1.3; color: #1a1a1a;">
                                @Model["Title"]
                            </h1>

                            <div class="rounded-4 overflow-hidden mb-4 shadow-sm" style="max-height: 440px;">
                                <img src="@Url.Content(img)" alt="@Model["Title"]" class="img-fluid w-100" style="object-fit: cover; max-height: 440px;">
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model["ShortDescription"]?.ToString()))
                            {
                                <div class="p-3 mb-4 rounded-3 border-start border-4 border-danger" style="background: #faf6f2;">
                                    <p class="mb-0 fst-italic text-muted" style="font-size: 1.05rem; line-height: 1.6;">
                                        @Model["ShortDescription"]
                                    </p>
                                </div>
                            }

                            <div class="article-body text-secondary" style="font-size: 1.05rem; line-height: 1.8;">
                                @if (Model["Description"] != DBNull.Value && !string.IsNullOrWhiteSpace(Model["Description"]?.ToString()))
                                {
                                    @Html.Raw(Model["Description"])
                                }
                                else
                                {
                                    <p>Shriram Janki Trust is committed to selfless humanitarian service, fostering social upliftment, providing free nutritious meals, organizing health checkups, and empowering underprivileged students with education. Every initiative is led by devoted volunteers and powered by compassionate donors from across India and beyond.</p>
                                }
                            </div>

                            <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div>
                                    <span class="fw-bold me-2 text-dark">Share this seva update:</span>
                                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle me-1"><i class="flaticon-facebook"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle me-1"><i class="flaticon-twitter"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-secondary rounded-circle"><i class="flaticon-linkedin-big-logo"></i></a>
                                </div>
                                <div>
                                    <a href="/Home/Donation" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold">
                                        <i class="flaticon-heart me-1"></i> Donate To This Cause
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <!-- Donation Box -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center text-white" style="background: linear-gradient(135deg, #e85a2a 0%, #d44719 100%);">
                        <i class="flaticon-heart display-4 mb-2"></i>
                        <h4 class="fw-bold mb-2">Be A Changemaker</h4>
                        <p class="small text-white-50 mb-4">Your small contribution helps provide meals, child education, and medical aid to those who need it most.</p>
                        <a href="/Home/Donation" class="btn btn-light text-danger fw-bold rounded-pill w-100 py-2">
                            Donate Now &nearr;
                        </a>
                    </div>

                    <!-- Recent News / Articles -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Recent Updates</h5>
                        <div class="d-flex flex-column gap-3">
                            @if (recentBlogs != null && recentBlogs.Rows.Count > 0)
                            {
                                int cnt = 0;
                                foreach (DataRow r in recentBlogs.Rows)
                                {
                                    if (cnt >= 4) break;
                                    int bId = Convert.ToInt32(r["BlogId"]);
                                    string bImg = !string.IsNullOrEmpty(r["ImagePath"]?.ToString()) ? r["ImagePath"].ToString()! : "/assets/img/blog-1.jpg";
                                    string bTitle = r["Title"]?.ToString() ?? "";
                                    DateTime dt = r["CreatedAt"] != DBNull.Value ? Convert.ToDateTime(r["CreatedAt"]) : DateTime.Now;

                                    <div class="d-flex gap-3 align-items-center">
                                        <img src="@Url.Content(bImg)" alt="@bTitle" class="rounded-3" style="width: 75px; height: 65px; object-fit: cover;">
                                        <div>
                                            <span class="text-muted" style="font-size: 0.75rem;"><i class="fa fa-calendar-alt me-1"></i>@dt.ToString("dd MMM yyyy")</span>
                                            <h6 class="mb-0" style="font-size: 0.9rem; line-height: 1.3;">
                                                <a href="/Home/BlogDetails/@bId" class="text-dark text-decoration-none">@bTitle</a>
                                            </h6>
                                        </div>
                                    </div>
                                    cnt++;
                                }
                            }
                        </div>
                    </div>

                    <!-- Active Causes -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3 border-bottom pb-2">Active Seva Causes</h5>
                        <ul class="list-unstyled mb-0">
                            @if (causes != null && causes.Rows.Count > 0)
                            {
                                foreach (DataRow c in causes.Rows)
                                {
                                    <li class="mb-2 pb-2 border-bottom">
                                        <a href="/Home/Donation?campaignId=@c["CampaignId"]" class="text-dark text-decoration-none d-flex justify-content-between align-items-center small">
                                            <span><i class="fa fa-angle-right text-danger me-2"></i>@c["Title"]</span>
                                            <span class="badge bg-light text-dark border">@c["Category"]</span>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- DETAILS SECTION END -->
</main>
