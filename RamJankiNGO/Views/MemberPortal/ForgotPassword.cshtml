@model RamJankiNGO.Models.ForgotPasswordRequestDto
@{
    ViewData["Title"] = "Forgot Password - Member Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ul-breadcrumb">
    <div class="ul-container container">
        <h2 class="ul-breadcrumb-title">Forgot Password</h2>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/MemberPortal/Login">Member Portal</a></li>
            <li>Forgot Password</li>
        </ul>
    </div>
</div>

<section class="ul-section-spacing" style="background: linear-gradient(135deg, #fff8f0 0%, #fff 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card shadow-lg border-0 p-4 p-md-5 rounded-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="rounded-circle bg-danger-subtle text-danger p-3 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fa fa-key fa-2x text-danger"></i>
                            </span>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Reset Your Password</h3>
                        <p class="text-muted small">Enter your registered email address. We will send a 6-digit verification OTP valid for <strong>2 minutes</strong>.</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            <i class="fa fa-exclamation-triangle me-1"></i> @ViewBag.ErrorMessage
                        </div>
                    }

                    <form method="post" action="/MemberPortal/ForgotPassword" autocomplete="off" id="forgotPassForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Registered Email Address (पंजीकृत ईमेल)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="fa fa-envelope"></i></span>
                                <input type="email" asp-for="Email" id="forgotEmail" class="form-control form-control-lg fs-6" required placeholder="Enter Registered Email Address" autocomplete="off" oninput="validateForgotEmail(this)" />
                            </div>
                            <div id="forgotEmailFeedback" class="small mt-1" style="display:none;"></div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 border-0 bg-warning-subtle text-warning-emphasis">
                            <i class="fa fa-clock me-1"></i> <strong>OTP Expiry:</strong> Aapke email par aane wala OTP sirf <strong>2 minute</strong> (120 seconds) ke liye valid hoga.
                        </div>

                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm py-2 mt-2">
                            <i class="fa fa-paper-plane me-1"></i> Send OTP to Email / OTP भेजें
                        </button>
                    </form>

                    <script>
                        function validateForgotEmail(input) {
                            const feedback = document.getElementById('forgotEmailFeedback');
                            if (!feedback) return;
                            const val = input.value.trim().toLowerCase();
                            if (val.length === 0) { feedback.style.display = 'none'; return; }
                            feedback.style.display = 'block';
                            var res = window.SJTValidator ? window.SJTValidator.validateEmail(val) : { valid: false, message: 'Validating...' };
                            if (res.valid) {
                                feedback.className = 'small mt-1 text-success fw-bold';
                                feedback.innerHTML = '<i class="fa fa-check-circle me-1"></i> ' + res.message;
                            } else {
                                feedback.className = 'small mt-1 text-danger fw-bold';
                                feedback.innerHTML = '<i class="fa fa-times-circle me-1"></i> ' + res.message;
                            }
                        }
                        document.getElementById('forgotPassForm')?.addEventListener('submit', function(e) {
                            const val = document.getElementById('forgotEmail').value.trim().toLowerCase();
                            var res = window.SJTValidator ? window.SJTValidator.validateEmail(val) : { valid: true };
                            if (!res.valid) {
                                e.preventDefault();
                                Swal.fire({
                                    icon: 'warning',
                                    title: res.isTypo ? 'गलत डोमेन (Domain Typo)' : 'Invalid Email',
                                    text: res.message,
                                    confirmButtonColor: '#e02b20'
                                });
                            }
                        });
                    </script>

                    <div class="text-center mt-4 border-top pt-3">
                        <a href="/MemberPortal/Login" class="text-muted small text-decoration-none">
                            <i class="fa fa-arrow-left me-1"></i> Back to Login / लॉगिन पर वापस जाएं
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
