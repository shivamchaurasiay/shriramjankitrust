@using System.Data
@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var member = ViewBag.Member as DataRow;
    var donations = ViewBag.Donations as DataTable;
}

<div class="ul-breadcrumb">
    <div class="ul-container container">
        <h2 class="ul-breadcrumb-title">Member Dashboard</h2>
        <ul>
            <li><a href="/">Home</a></li>
            <li>Dashboard</li>
        </ul>
    </div>
</div>

<section class="ul-section-spacing bg-light">
    <div class="container">
        <!-- Profile Header -->
        <div class="card shadow-sm border-0 p-4 rounded-4 mb-4 bg-white">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 65px; height: 65px;">
                            @(member != null && !string.IsNullOrEmpty(member["FullName"]?.ToString()) ? member["FullName"].ToString()!.Substring(0, 1).ToUpper() : "M")
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@(member != null ? member["FullName"] : "Member")</h4>
                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <span class="badge bg-danger">Member ID: @(member != null ? member["MemberCode"] : "-")</span>
                                <span class="badge bg-secondary">@(member != null ? member["MemberType"] : "Regular")</span>
                                <span class="text-muted small"><i class="fa fa-phone me-1"></i>@(member != null ? member["Mobile"] : "")</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/MemberPortal/Profile" class="btn btn-outline-danger btn-sm me-2"><i class="fa fa-user-edit me-1"></i> Edit Profile</a>
                    <a href="/MemberPortal/Logout" class="btn btn-light btn-sm text-danger"><i class="fa fa-sign-out-alt me-1"></i> Logout</a>
                </div>
            </div>
        </div>

        <!-- Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-3 rounded-3 bg-white">
                    <span class="text-muted small fw-bold">TOTAL SEVA CONTRIBUTED</span>
                    <h3 class="fw-bold text-danger mb-0">₹@(member != null ? Convert.ToDecimal(member["TotalDonated"]).ToString("N0") : "0")</h3>
                    <small class="text-muted">Lifetime donation amount</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-3 rounded-3 bg-white">
                    <span class="text-muted small fw-bold">SUCCESSFUL DONATIONS</span>
                    <h3 class="fw-bold text-success mb-0">@(member != null ? member["TotalDonationsCount"] : "0")</h3>
                    <small class="text-muted">Total verified transactions</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 p-3 rounded-3 bg-white d-flex justify-content-center">
                    <a href="/Home/Donation" class="btn btn-danger fw-bold"><i class="fa fa-heart me-1"></i> Make A New Donation</a>
                </div>
            </div>
        </div>

        <!-- Donation History Table -->
        <div class="card shadow-sm border-0 p-4 rounded-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="fa fa-receipt text-danger me-2"></i> My Donation History & Receipts</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Receipt No</th>
                            <th>Date</th>
                            <th>Cause / Seva</th>
                            <th>Amount</th>
                            <th>Payment Mode</th>
                            <th>Status</th>
                            <th>Download Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (donations != null && donations.Rows.Count > 0)
                        {
                            foreach (DataRow row in donations.Rows)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">@(row["ReceiptNumber"]?.ToString() ?? row["DonationCode"].ToString())</span></td>
                                    <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd-MMM-yyyy")</td>
                                    <td class="fw-bold">@(row["CampaignTitle"] != DBNull.Value ? row["CampaignTitle"].ToString() : "General Fund")</td>
                                    <td class="fw-bold text-success">₹@Convert.ToDecimal(row["Amount"]).ToString("N0")</td>
                                    <td>@row["PaymentMode"]</td>
                                    <td>
                                        @if (row["PaymentStatus"].ToString() == "Successful")
                                        {
                                            <span class="badge bg-success">Successful</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@row["PaymentStatus"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row["PaymentStatus"].ToString() == "Successful")
                                        {
                                            <a href="/MemberPortal/Receipt/@row["DonationId"]" target="_blank" class="btn btn-sm btn-outline-danger">
                                                <i class="fa fa-file-pdf me-1"></i> Receipt PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No donation records found. Make your first contribution today!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
