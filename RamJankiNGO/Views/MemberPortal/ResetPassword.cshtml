@model RamJankiNGO.Models.ResetPasswordWithOtpDto
@{
    ViewData["Title"] = "Verify OTP & Reset Password - Member Portal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ul-breadcrumb">
    <div class="ul-container container">
        <h2 class="ul-breadcrumb-title">Verify OTP</h2>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/MemberPortal/Login">Member Portal</a></li>
            <li>Reset Password</li>
        </ul>
    </div>
</div>

<section class="ul-section-spacing" style="background: linear-gradient(135deg, #fff8f0 0%, #fff 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="card shadow-lg border-0 p-4 p-md-5 rounded-4">
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <span class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fa fa-shield-alt fa-2x text-success"></i>
                            </span>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Verify OTP &amp; Reset Password</h3>
                        <p class="text-muted small">
                            OTP sent to <strong>@Model.Email</strong>
                        </p>

                        <!-- Live 2-Minute Expiry Countdown -->
                        <div class="p-2 rounded-3 bg-light border d-inline-flex align-items-center gap-2 mt-1">
                            <i class="fa fa-stopwatch text-danger"></i>
                            <span class="small text-secondary">OTP Valid for:</span>
                            <span id="countdownTimer" class="fw-bold text-danger fs-6" style="min-width: 50px;">02:00</span>
                        </div>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                            <i class="fa fa-exclamation-triangle me-1"></i> @ViewBag.ErrorMessage
                        </div>
                    }
                    @if (TempData["AuthSuccess"] != null)
                    {
                        <div class="alert alert-success py-2 px-3 small rounded-3 mb-3">
                            <i class="fa fa-check-circle me-1"></i> @TempData["AuthSuccess"]
                        </div>
                    }

                    <div id="expiredAlert" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none">
                        <i class="fa fa-clock me-1"></i> <strong>OTP Expired!</strong> 2 minutes samapt ho chuke hain. Kripya naya OTP generate karein.
                        <div class="mt-2">
                            <a href="/MemberPortal/ForgotPassword" class="btn btn-sm btn-outline-danger fw-bold">Naya OTP Mangwayein (Resend)</a>
                        </div>
                    </div>

                    <form method="post" action="/MemberPortal/ResetPassword" id="resetForm" autocomplete="off">
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Enter 6-Digit Verification OTP <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Otp" maxlength="6" class="form-control form-control-lg text-center fw-bold fs-4"
                                   required placeholder="______" style="letter-spacing: 8px;" autocomplete="off" />
                            <span asp-validation-for="Otp" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">New Password (नया पासवर्ड) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="fa fa-lock"></i></span>
                                <input type="password" asp-for="NewPassword" class="form-control form-control-lg fs-6" required placeholder="Minimum 6 characters" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Confirm New Password (पासवर्ड की पुष्टि) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="fa fa-check-double"></i></span>
                                <input type="password" asp-for="ConfirmPassword" class="form-control form-control-lg fs-6" required placeholder="Re-enter new password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm py-2 mt-2">
                            <i class="fa fa-check-circle me-1"></i> Save New Password / पासवर्ड अपडेट करें
                        </button>
                    </form>

                    <div class="text-center mt-4 border-top pt-3 d-flex justify-content-between align-items-center">
                        <a href="/MemberPortal/ForgotPassword" class="text-danger small fw-semibold text-decoration-none">
                            <i class="fa fa-redo me-1"></i> Resend OTP
                        </a>
                        <a href="/MemberPortal/Login" class="text-muted small text-decoration-none">
                            Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // 2-minute countdown timer (120 seconds)
        let totalSeconds = 120;
        const timerElement = document.getElementById('countdownTimer');
        const expiredAlert = document.getElementById('expiredAlert');
        const submitBtn = document.getElementById('submitBtn');

        const interval = setInterval(function () {
            totalSeconds--;

            if (totalSeconds <= 0) {
                clearInterval(interval);
                timerElement.innerText = "00:00";
                timerElement.classList.add('text-muted');
                timerElement.classList.remove('text-danger');
                expiredAlert.classList.remove('d-none');
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-50');
            } else {
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                timerElement.innerText = (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
            }
        }, 1000);
    </script>
}
