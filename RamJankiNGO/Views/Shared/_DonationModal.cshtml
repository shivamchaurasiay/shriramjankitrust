<!-- GLOBAL DONATION MODAL -->
<div class="modal fade" id="donationModal" tabindex="-1" aria-labelledby="donationModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header bg-danger text-white p-3 p-md-4">
                <div>
                    <h4 class="modal-title fw-bold text-white mb-0" id="donationModalLabel">
                        <i class="flaticon-heart me-1"></i> Make a Seva Donation
                    </h4>
                    <p class="text-white-50 small mb-0">Shriram Janki Trust &bull; Dedicated to Education, Health & Food Seva</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 p-md-5">
                <!-- Member Login / Autofill Alert -->
                <div id="memberAutofillAlert" class="alert alert-success d-none py-2 px-3 small rounded-3 mb-4">
                    <i class="fa fa-check-circle me-1"></i> <strong>Logged in Member:</strong> <span id="autofillMemberText"></span> (Details autofilled)
                </div>
                <div id="guestLoginPrompt" class="alert alert-light border py-2 px-3 small rounded-3 mb-4 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-user-circle me-1 text-muted"></i> Donating as a registered member?</span>
                    <a href="/MemberPortal/Login" class="text-danger fw-bold">Login to Autofill &rarr;</a>
                </div>

                <form method="post" action="/Home/Donation" id="modalDonationForm" autocomplete="off">
                    <input type="hidden" name="MemberId" id="modalMemberId" value="" />

                    <!-- 1. Cause -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Select Cause / Seva Program</label>
                        <select name="CampaignId" id="modalCampaignSelect" class="form-select form-select-lg">
                            <option value="">General Social Welfare & Seva Fund</option>
                            <option value="1">Child Education & School Kits Support</option>
                            <option value="2">Rural Free Health Camps & Medicine Distribution</option>
                            <option value="3">Daily Food Relief & Annakshetra</option>
                        </select>
                    </div>

                    <!-- 2. Amount Presets -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Select Donation Amount (INR)</label>
                        <div class="row g-2 mb-2">
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold modal-amt-btn" onclick="setModalAmount(500)">₹500</button>
                            </div>
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-danger w-100 py-2 fw-bold modal-amt-btn active" onclick="setModalAmount(1000)">₹1,000</button>
                            </div>
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold modal-amt-btn" onclick="setModalAmount(2500)">₹2,500</button>
                            </div>
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold modal-amt-btn" onclick="setModalAmount(5000)">₹5,000</button>
                            </div>
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold modal-amt-btn" onclick="setModalAmount(10000)">₹10,000</button>
                            </div>
                            <div class="col-4 col-sm-2">
                                <button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" onclick="document.getElementById('modalAmountInput').focus()">Custom</button>
                            </div>
                        </div>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white fw-bold">₹</span>
                            <input type="number" step="1" name="Amount" id="modalAmountInput" class="form-control" value="1000" min="1" required placeholder="Amount in ₹" autocomplete="off" />
                        </div>
                    </div>

                    <!-- 3. Donor Details -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="DonorName" id="modalDonorName" class="form-control" required placeholder="Your Full Name" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Mobile Number <span class="text-danger">*</span></label>
                            <input type="tel" name="DonorPhone" id="modalDonorPhone" class="form-control" required placeholder="10-digit Mobile Number" maxlength="10" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Email Address (for Receipt)</label>
                            <input type="email" name="DonorEmail" id="modalDonorEmail" class="form-control" placeholder="donor@example.com" autocomplete="off" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">PAN Number (Optional)</label>
                            <input type="text" name="DonorPan" id="modalDonorPan" class="form-control" placeholder="e.g. ABCDE1234F" autocomplete="off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted mb-1">City / Address</label>
                            <input type="text" name="DonorAddress" id="modalDonorAddress" class="form-control" placeholder="City, State" autocomplete="off" />
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-4">
                        <div class="small text-muted"><i class="fa fa-shield-alt text-success me-1"></i> Instant Official 80G Receipt Upon Payment</div>
                        <span class="badge bg-white text-dark border">UPI / Card / NetBanking</span>
                    </div>

                    <button type="button" class="btn btn-danger btn-lg w-100 py-3 fw-bold fs-5 shadow" onclick="launchModalRazorpayCheckout()">
                        <i class="flaticon-heart me-1"></i> Pay via Payment Gateway &rarr;
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    function openDonationModal(campaignId, campaignTitle) {
        if (campaignId) {
            var sel = document.getElementById('modalCampaignSelect');
            if (sel) {
                sel.value = campaignId;
            }
        }

        // Fetch logged in member info to autofill
        fetch('/Home/GetCurrentMember')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data && data.loggedIn) {
                    document.getElementById('modalMemberId').value = data.memberId;
                    document.getElementById('modalDonorName').value = data.fullName;
                    document.getElementById('modalDonorPhone').value = data.mobile;
                    document.getElementById('modalDonorEmail').value = data.email;
                    document.getElementById('modalDonorAddress').value = data.address;

                    document.getElementById('autofillMemberText').innerText = data.fullName + ' (' + data.memberCode + ')';
                    document.getElementById('memberAutofillAlert').classList.remove('d-none');
                    document.getElementById('guestLoginPrompt').classList.add('d-none');
                } else {
                    document.getElementById('memberAutofillAlert').classList.add('d-none');
                    document.getElementById('guestLoginPrompt').classList.remove('d-none');
                }
            })
            .catch(function(err) {
                console.log('Error fetching member session:', err);
            });

        var myModal = new bootstrap.Modal(document.getElementById('donationModal'));
        myModal.show();
    }

    function setModalAmount(amt) {
        document.getElementById('modalAmountInput').value = amt;
        var btns = document.querySelectorAll('.modal-amt-btn');
        btns.forEach(function(b) {
            b.classList.remove('btn-danger', 'active');
            b.classList.add('btn-outline-danger');
            if (b.innerText.indexOf(amt.toLocaleString('en-IN')) !== -1) {
                b.classList.remove('btn-outline-danger');
                b.classList.add('btn-danger', 'active');
            }
        });
    }

    function launchModalRazorpayCheckout() {
        var name = document.getElementById('modalDonorName').value.trim();
        var phone = document.getElementById('modalDonorPhone').value.trim();
        var email = document.getElementById('modalDonorEmail').value.trim();
        var amt = parseFloat(document.getElementById('modalAmountInput').value);
        var campSelect = document.getElementById('modalCampaignSelect');
        var causeTitle = campSelect.options[campSelect.selectedIndex].text;

        if (!name) {
            Swal.fire({ icon: 'warning', title: 'Name Required', text: 'Please enter your full name.', confirmButtonColor: '#e03e2d' });
            document.getElementById('modalDonorName').focus();
            return;
        }
        if (!phone || phone.length < 10) {
            Swal.fire({ icon: 'warning', title: 'Mobile Required', text: 'Please enter a valid 10-digit mobile number.', confirmButtonColor: '#e03e2d' });
            document.getElementById('modalDonorPhone').focus();
            return;
        }
        if (email && email.length > 0) {
            var emailCheck = window.SJTValidator ? window.SJTValidator.validateEmail(email) : { valid: true };
            if (!emailCheck.valid) {
                Swal.fire({
                    icon: 'warning',
                    title: emailCheck.isTypo ? 'गलत डोमेन (Domain Typo)' : 'Invalid Email',
                    text: emailCheck.message,
                    confirmButtonColor: '#e03e2d'
                });
                document.getElementById('modalDonorEmail').focus();
                return;
            }
        }
        if (isNaN(amt) || amt <= 0) {
            Swal.fire({ icon: 'warning', title: 'Amount Required', text: 'Please enter a valid donation amount.', confirmButtonColor: '#e03e2d' });
            document.getElementById('modalAmountInput').focus();
            return;
        }

        var options = {
            "key": "rzp_test_1DP5mmOlF5G5ag",
            "amount": Math.round(amt * 100),
            "currency": "INR",
            "name": "SHRI RAM JANKI MANDIR SEWA TRUST",
            "description": "Seva Donation for " + causeTitle,
            "image": "/assets/img/logo.png",
            "prefill": {
                "name": name,
                "email": email || "donor@shriramjankitrust.com",
                "contact": phone
            },
            "theme": { "color": "#e03e2d" },
            "handler": function (response) {
                if (!response.razorpay_payment_id) {
                    Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'No transaction ID returned.', confirmButtonColor: '#e03e2d' });
                    return;
                }

                // Hide Modal
                var modalEl = document.getElementById('donationModal');
                var modalInst = bootstrap.Modal.getInstance(modalEl);
                if (modalInst) modalInst.hide();

                Swal.fire({
                    title: 'Verifying Payment...',
                    text: 'Please wait while your donation is recorded and official receipt is issued.',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                var payload = {
                    amount: amt,
                    donorName: name,
                    donorPhone: phone,
                    donorEmail: email,
                    donorAddress: document.getElementById('modalDonorAddress').value,
                    donorPan: document.getElementById('modalDonorPan').value,
                    campaignId: parseInt(document.getElementById('modalCampaignSelect').value) || null,
                    memberId: parseInt(document.getElementById('modalMemberId').value) || null,
                    razorpayPaymentId: response.razorpay_payment_id,
                    paymentMode: 'Razorpay Online'
                };

                fetch('/Home/ConfirmGatewayDonation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'जय श्री राम! दान सफल रहा',
                            html: '<div class="text-center"><p class="mb-2">Thank you for your noble seva! Your donation has been received successfully.</p><p class="fs-5 fw-bold text-danger mb-2">Receipt No: ' + data.receiptNumber + '</p><p class="text-muted small mb-0">Official 80G receipt has been emailed to you.</p></div>',
                            confirmButtonColor: '#e03e2d',
                            confirmButtonText: 'View Receipt / रसीद देखें'
                        }).then(function() {
                            window.location.href = data.redirectUrl;
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Verification Error', text: data.message, confirmButtonColor: '#e03e2d' });
                    }
                })
                .catch(function(err) {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to verify payment with server.', confirmButtonColor: '#e03e2d' });
                });
            },
            "modal": {
                "ondismiss": function() {
                    Swal.fire({
                        icon: 'info',
                        title: 'Payment Not Completed',
                        text: 'Payment was cancelled or closed. No donation receipt has been generated.',
                        confirmButtonColor: '#e03e2d',
                        timer: 3500
                    });
                }
            }
        };

        var rzp = new Razorpay(options);
        rzp.open();
    }

    // Attach to any element with data-donate-btn
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('a[href*="donations.html"], a[href*="donation-details.html"]').forEach(function(el) {
            if (!el.closest('.ul-header-nav')) {
                el.addEventListener('click', function(e) {
                    e.preventDefault();
                    var campId = el.getAttribute('data-campaign-id') || null;
                    var campTitle = el.getAttribute('data-campaign-title') || null;
                    openDonationModal(campId, campTitle);
                });
            }
        });
    });
</script>
