<!-- Mobile Drawer Overlay Backdrop -->
<div class="ul-sidebar-backdrop" id="ulSidebarBackdrop" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.5); z-index:998; backdrop-filter:blur(2px); transition:opacity 0.3s ease;"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".ul-sidebar");
        const opener = document.querySelector(".ul-header-sidebar-opener");
        const closer = document.querySelector(".ul-sidebar-closer");
        const backdrop = document.getElementById("ulSidebarBackdrop");

        function openSidebar() {
            if (sidebar) sidebar.classList.add("active");
            if (backdrop) backdrop.style.display = "block";
            document.body.style.overflow = "hidden";
            bindSubmenuToggles();
        }

        function closeSidebar() {
            if (sidebar) sidebar.classList.remove("active");
            if (backdrop) backdrop.style.display = "none";
            document.body.style.overflow = "";
        }

        if (opener) opener.addEventListener("click", openSidebar);
        if (closer) closer.addEventListener("click", closeSidebar);
        if (backdrop) backdrop.addEventListener("click", closeSidebar);

        // Accordion Submenu Toggle (Open / Close on Click)
        function bindSubmenuToggles() {
            const subMenuAnchors = document.querySelectorAll(".ul-sidebar .has-sub-menu > a");
            subMenuAnchors.forEach(function (anchor) {
                anchor.onclick = function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const parent = this.closest(".has-sub-menu");
                    if (parent) {
                        const isOpen = parent.classList.contains("active");
                        // Close other open submenus
                        document.querySelectorAll(".ul-sidebar .has-sub-menu.active").forEach(function (item) {
                            if (item !== parent) item.classList.remove("active");
                        });
                        if (isOpen) {
                            parent.classList.remove("active");
                        } else {
                            parent.classList.add("active");
                        }
                    }
                };
            });
        }

        // Initialize on load and on resize
        setTimeout(bindSubmenuToggles, 300);
        window.addEventListener("resize", function () {
            if (window.innerWidth < 992) {
                setTimeout(bindSubmenuToggles, 200);
            }
        });
    });
</script>
<!-- SIDEBAR SECTION END -->
