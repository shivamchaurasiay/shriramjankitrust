<style>
    /* Public Header Polish & Responsiveness */
    .ul-header-2 .ul-header-bottom-wrapper {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
        justify-content: space-between !important;
        width: 100% !important;
        max-width: 100% !important;
        padding: 8px 16px !important;
    }
    .custom-logo-brand {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        text-decoration: none !important;
        flex-shrink: 0 !important;
    }
    .brand-logo-img {
        height: 48px;
        width: auto;
        object-fit: contain;
    }
    .brand-text-wrapper {
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: left;
    }
    .brand-title {
        font-size: 17px;
        font-weight: 800;
        color: #1a1a1a;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.15;
        font-family: 'Cinzel', 'Times New Roman', serif;
    }
    .brand-tagline {
        font-size: 11px;
        font-weight: 500;
        color: #666666;
        letter-spacing: 0.3px;
        margin-top: 2px;
    }

    .ul-header-nav-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
        flex-shrink: 1;
        min-width: 0;
    }
    .ul-header-nav {
        display: flex;
        align-items: center;
        gap: clamp(8px, 1.2vw, 20px);
        flex-wrap: nowrap;
    }
    .ul-header-nav a, .ul-header-nav [role="button"] {
        font-size: 14.5px;
        font-weight: 600;
        color: #222;
        white-space: nowrap;
        padding: 6px 4px;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .ul-header-nav a:hover, .ul-header-nav [role="button"]:hover {
        color: #e02b20 !important;
    }

    .ul-header-actions {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        flex-shrink: 0 !important;
        margin-left: auto !important;
    }
    /* Desktop Donate Button: ONLY visible on desktop (>= 992px), completely hidden on mobile */
    .ul-header-actions .ul-btn {
        display: none !important;
    }
    @@media (min-width: 992px) {
        .ul-header-actions .ul-btn {
            display: inline-flex !important;
            padding: 9px 20px !important;
            font-size: 14px !important;
            font-weight: 700 !important;
            border-radius: 50px !important;
            white-space: nowrap !important;
            align-items: center !important;
            gap: 6px !important;
            box-shadow: 0 4px 12px rgba(224, 43, 32, 0.25) !important;
            background-color: #e02b20 !important;
            color: #fff !important;
        }
    }

    /* Mobile Hamburger Menu Opener: ONLY visible on mobile/tablet (<= 991px), hidden on desktop */
    .ul-header-sidebar-opener {
        display: none !important;
        background: transparent !important;
        border: none !important;
        padding: 6px 8px !important;
        font-size: 24px !important;
        color: #1a1a1a !important;
        cursor: pointer;
        align-items: center !important;
        justify-content: center !important;
        line-height: 1 !important;
    }
    .ul-header-sidebar-opener i {
        color: #1a1a1a !important;
        font-size: 24px !important;
    }
    @@media (max-width: 991px) {
        .ul-header-sidebar-opener {
            display: inline-flex !important;
        }
    }

    /* Screen Breakpoints */
    @@media (max-width: 1366px) {
        .brand-title {
            font-size: 15px;
        }
        .brand-tagline {
            display: none;
        }
        .ul-header-nav a, .ul-header-nav [role="button"] {
            font-size: 13.5px;
        }
        .ul-header-nav {
            gap: 10px;
        }
    }
    @@media (max-width: 1120px) {
        .brand-title {
            font-size: 14px;
        }
        .ul-header-nav a, .ul-header-nav [role="button"] {
            font-size: 13px;
        }
        .ul-header-nav {
            gap: 8px;
        }
        .ul-header-actions .ul-btn {
            padding: 8px 14px !important;
            font-size: 13px !important;
        }
    }
    @@media (max-width: 991px) {
        .brand-logo-img {
            height: 42px;
        }
        .brand-title {
            font-size: 15px;
        }
        .brand-tagline {
            display: none;
        }
    }
    @@media (max-width: 576px) {
        .brand-logo-img {
            height: 38px;
        }
        .brand-title {
            font-size: 13.5px;
            max-width: 220px;
            line-height: 1.15;
        }
        .ul-header-2 .ul-header-bottom-wrapper {
            padding: 6px 12px !important;
        }
    }
</style>

<!-- HEADER SECTION START -->
