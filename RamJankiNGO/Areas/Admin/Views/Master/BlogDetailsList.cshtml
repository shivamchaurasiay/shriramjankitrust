@model IEnumerable<RamJankiNGO.Models.BlogDetailsDto>
@{
    ViewData["Title"] = "Blogs & News List";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>News &amp; Blog Posts</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item">CMS Masters</li>
                        <li class="breadcrumb-item active">News &amp; Blogs</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-newspaper text-primary me-2"></i> Published Articles &amp; News (@(Model?.Count() ?? 0))</h5>
                        <a href="/Admin/Master/AddBlogDetails" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus me-1"></i> Add News / Blog
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 65px;">Sr. No.</th>
                                        <th class="text-center" style="width: 100px;">Banner</th>
                                        <th style="width: 130px;">Category</th>
                                        <th>Headline / Title</th>
                                        <th style="width: 110px;">Post Date</th>
                                        <th style="min-width: 200px;">Summary</th>
                                        <th class="text-center" style="width: 120px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || !Model.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                <i class="fa fa-newspaper fa-2x text-muted mb-2 d-block opacity-50"></i>
                                                No blog posts found. Click "Add News / Blog" to create an article.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int index = 1;
                                        foreach (var contact in Model)
                                        {
                                            var blogImg = string.IsNullOrEmpty(contact.Filename) 
                                                ? "/assets/img/blog-1.jpg" 
                                                : (contact.Filename.StartsWith("/") || contact.Filename.StartsWith("http") 
                                                    ? contact.Filename 
                                                    : "/uploads/" + contact.Filename);

                                            <tr>
                                                <td class="text-center fw-bold">@index</td>
                                                <td class="text-center">
                                                    <img src="@blogImg" style="height: 55px; width: 75px; object-fit: cover; border-radius: 6px; border: 1px solid #dee2e6;" alt="Blog" onerror="this.src='/assets/img/blog-1.jpg';" />
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-primary border">@contact.BlogTopic</span>
                                                </td>
                                                <td>
                                                    <div class="f-w-600">@contact.BlogHeading</div>
                                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@contact.BlogTittle</div>
                                                </td>
                                                <td class="small text-muted">@contact.PostDate</td>
                                                <td>
                                                    <div class="small text-muted" style="max-height: 60px; overflow: hidden; line-height: 1.4;">
                                                        @Html.Raw(contact.BlogDescription)
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/Admin/Master/AddBlogDetails?id=@contact.BlogId" class="btn btn-outline-primary" title="Edit">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a href="/Admin/Master/DeleteBlogDetails?id=@contact.BlogId" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this blog post?');">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
