@model RamJankiNGO.Models.GalleryDetailsDto
@{
    bool isEdit = Model != null && Model.GalleryDId > 0;
    ViewData["Title"] = isEdit ? "Edit Gallery Photo Details" : "Add Gallery Photo Details";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>@(isEdit ? "Edit Gallery Photo Details" : "Add New Gallery Photo")</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item"><a href="/Admin/Master/GalleryDetailsList">Gallery Photos</a></li>
                        <li class="breadcrumb-item active">@(isEdit ? "Edit Photo" : "Add Photo")</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-9 col-lg-11 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="f-w-600 mb-0">
                            <i class="fa fa-image text-primary me-2"></i>
                            @(isEdit ? "Edit Gallery Photo" : "Upload New Gallery Photo")
                        </h5>
                        <a href="/Admin/Master/GalleryDetailsList" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i> Back to Photos List
                        </a>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/Admin/Master/AddGalleryDetails" enctype="multipart/form-data">
                            <input type="hidden" asp-for="GalleryDId" />
                            <input type="hidden" asp-for="Filename" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="GalleryMId">Select Gallery Album / Category <span class="text-danger">*</span></label>
                                    <select class="form-select" id="GalleryMId" asp-for="GalleryMId" required>
                                        <option value="">-- Select Album / Category --</option>
                                        @if (ViewBag.service != null)
                                        {
                                            foreach (var item in (List<SelectListItem>)ViewBag.service)
                                            {
                                                if (Model != null && Model.GalleryMId.ToString() == item.Value)
                                                {
                                                    <option value="@item.Value" selected="selected">@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <span class="text-danger" asp-validation-for="GalleryMId"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="ImageTitle">Photo Title / Caption <span class="text-danger">*</span></label>
                                    <input class="form-control" asp-for="ImageTitle" id="ImageTitle" type="text" placeholder="e.g. Free Eye Screening Camp Ayodhya" required autocomplete="off" />
                                    <span class="text-danger" asp-validation-for="ImageTitle"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="FilePath">
                                        Upload Photo @(isEdit ? "(Leave blank to keep existing photo)" : "")
                                        @if (!isEdit)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    @if (isEdit)
                                    {
                                        <input class="form-control" asp-for="FilePath" id="FilePath" type="file" accept="image/*" />
                                    }
                                    else
                                    {
                                        <input class="form-control" asp-for="FilePath" id="FilePath" type="file" accept="image/*" required />
                                    }
                                    <span class="text-danger" asp-validation-for="FilePath"></span>

                                    @if (Model != null && !string.IsNullOrEmpty(Model.Filename))
                                    {
                                        var imgSrc = (Model.Filename.StartsWith("/") || Model.Filename.StartsWith("http")) ? Model.Filename : ("/uploads/" + Model.Filename);
                                        <div class="mt-3 p-2 border rounded bg-light d-flex align-items-center gap-3">
                                            <img src="@imgSrc" alt="Current Photo" class="rounded border shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" onerror="this.src='/assets/img/gallery-1.jpg';" />
                                            <div>
                                                <div class="small fw-bold text-dark">Current Photo</div>
                                                <div class="text-muted small">Choose a new file above only if you want to replace this image.</div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="Status">Status</label>
                                    <select class="form-select" asp-for="Status" id="Status">
                                        <option value="1">Active</option>
                                        <option value="0">Inactive</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="Status"></span>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                                <a href="/Admin/Master/GalleryDetailsList" class="btn btn-outline-secondary">
                                    <i class="fa fa-times me-1"></i> Cancel
                                </a>
                                <button class="btn btn-primary" type="submit">
                                    <i class="fa fa-save me-1"></i> @(isEdit ? "Update Photo Details" : "Upload & Save Photo")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid Ends-->
</div>
