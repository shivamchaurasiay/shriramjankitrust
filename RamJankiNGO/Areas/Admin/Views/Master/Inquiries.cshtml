@model System.Data.DataTable
@using System.Data
@{
    ViewData["Title"] = "Contact Messages";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Public Inquiries & Messages</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index"><i data-feather="home"></i></a></li>
                        <li class="breadcrumb-item">Inquiries</li>
                        <li class="breadcrumb-item active">List</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-envelope-open-text text-success me-2"></i> Messages received from Contact Form (@Model.Rows.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Sender Name</th>
                                        <th>Contact</th>
                                        <th>Subject</th>
                                        <th>Message</th>
                                        <th>Status</th>
                                        <th class="text-center" style="width: 100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Rows.Count > 0)
                                    {
                                        foreach (DataRow row in Model.Rows)
                                        {
                                            <tr id="inquiry-row-@row["InquiryId"]">
                                                <td style="width: 130px;">@Convert.ToDateTime(row["CreatedAt"]).ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="f-w-600">@row["Name"]</td>
                                                <td>
                                                    <div><a href="mailto:@row["Email"]" class="text-primary text-decoration-none"><i class="fa fa-envelope me-1 text-muted"></i>@row["Email"]</a></div>
                                                    @if (row["Phone"] != DBNull.Value && !string.IsNullOrWhiteSpace(row["Phone"]?.ToString()))
                                                    {
                                                        <div><a href="tel:@row["Phone"]" class="text-dark text-decoration-none"><i class="fa fa-phone me-1 text-muted"></i>+91 @row["Phone"]</a></div>
                                                    }
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@row["Subject"]</span></td>
                                                <td style="max-width: 280px; word-break: break-word;">@row["Message"]</td>
                                                <td><span class="badge bg-success">@row["Status"]</span></td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-outline-danger btn-xs" onclick="deleteInquiry(@row["InquiryId"])" title="Delete Inquiry">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">No contact inquiries received yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteInquiry(id) {
        if (!confirm('Are you sure you want to delete this inquiry record?')) return;
        fetch('/Admin/Master/DeleteInquiry?id=' + id, {
            method: 'POST'
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const el = document.getElementById('inquiry-row-' + id);
                if (el) el.remove();
            } else {
                alert(data.message || 'Failed to delete inquiry');
            }
        })
        .catch(err => {
            console.error(err);
            alert('Error deleting inquiry');
        });
    }
</script>
