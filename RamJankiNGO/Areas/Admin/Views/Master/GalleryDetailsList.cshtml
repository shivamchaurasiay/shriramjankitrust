@model IEnumerable<RamJankiNGO.Models.GalleryDetailsDto>
@{
    ViewData["Title"] = "Gallery Details List";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Gallery Photos Directory</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item">CMS Masters</li>
                        <li class="breadcrumb-item active">Gallery Photos</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-images text-primary me-2"></i> All Gallery Photos (@(Model?.Count() ?? 0))</h5>
                        <a href="/Admin/Master/AddGalleryDetails" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus me-1"></i> Add New Photo
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 70px;">Sr. No.</th>
                                        <th class="text-center" style="width: 120px;">Photo Preview</th>
                                        <th>Album / Category Name</th>
                                        <th>Photo Title / Caption</th>
                                        <th class="text-center" style="width: 100px;">Status</th>
                                        <th class="text-center" style="width: 130px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || !Model.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="fa fa-images fa-2x text-muted mb-2 d-block opacity-50"></i>
                                                No gallery photos found. Click "Add New Photo" to upload photos.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int index = 1;
                                        foreach (var contact in Model)
                                        {
                                            var gImg = string.IsNullOrEmpty(contact.Filename) 
                                                ? "/assets/img/gallery-1.jpg" 
                                                : (contact.Filename.StartsWith("/") || contact.Filename.StartsWith("http") 
                                                    ? contact.Filename 
                                                    : "/uploads/" + contact.Filename);

                                            <tr>
                                                <td class="text-center fw-bold">@index</td>
                                                <td class="text-center">
                                                    <a href="@gImg" target="_blank" title="Click to view full image">
                                                        <img src="@gImg" class="rounded border shadow-sm" style="height: 60px; width: 80px; object-fit: cover;" alt="Gallery" onerror="this.src='/assets/img/gallery-1.jpg';" />
                                                    </a>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-primary border fs-6">
                                                        <i class="fa fa-folder-open me-1"></i> @(string.IsNullOrEmpty(contact.Action) ? contact.GalleryName : contact.Action)
                                                    </span>
                                                </td>
                                                <td class="fw-semibold">
                                                    @(string.IsNullOrEmpty(contact.ImageTitle) ? "Seva Welfare Photo" : contact.ImageTitle)
                                                </td>
                                                <td class="text-center">
                                                    @if (contact.Status == 1)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/Admin/Master/AddGalleryDetails?id=@contact.GalleryDId" class="btn btn-outline-primary" title="Edit">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a href="/Admin/Master/DeleteGalleryDetails?id=@contact.GalleryDId" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this gallery photo?');">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
