@model RamJankiNGO.Models.TeamDetailsDto
@{
    bool isEdit = Model != null && Model.TeamsId > 0;
    ViewData["Title"] = isEdit ? "Edit Team Member" : "Add Team Member";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>@(isEdit ? "Edit Team Member Details" : "Add New Team Member")</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item"><a href="/Admin/Master/OurTeamDetailsList">Team Members</a></li>
                        <li class="breadcrumb-item active">@(isEdit ? "Edit Member" : "Add Member")</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-9 col-lg-11 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="f-w-600 mb-0">
                            <i class="fa fa-users text-primary me-2"></i>
                            @(isEdit ? "Edit Team Member Information" : "Add New Team Member")
                        </h5>
                        <a href="/Admin/Master/OurTeamDetailsList" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left me-1"></i> Back to Team List
                        </a>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/Admin/Master/AddOurTeamDetails" enctype="multipart/form-data">
                            <input type="hidden" asp-for="TeamsId" />
                            <input type="hidden" asp-for="Filename" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="Name">Member Name <span class="text-danger">*</span></label>
                                    <input class="form-control" asp-for="Name" id="Name" type="text" placeholder="e.g. Acharya Rajesh Sharma" required autocomplete="off" />
                                    <span class="text-danger" asp-validation-for="Name"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="Designation">Designation / Role <span class="text-danger">*</span></label>
                                    <input class="form-control" asp-for="Designation" id="Designation" type="text" placeholder="e.g. Founder & Managing Trustee" required autocomplete="off" />
                                    <span class="text-danger" asp-validation-for="Designation"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="FilePath">
                                        Member Photo @(isEdit ? "(Leave blank to keep existing photo)" : "")
                                        @if (!isEdit)
                                        {
                                            <span class="text-danger">*</span>
                                        }
                                    </label>
                                    @if (isEdit)
                                    {
                                        <input class="form-control" asp-for="FilePath" id="FilePath" type="file" accept="image/*" />
                                    }
                                    else
                                    {
                                        <input class="form-control" asp-for="FilePath" id="FilePath" type="file" accept="image/*" required />
                                    }
                                    <span class="text-danger" asp-validation-for="FilePath"></span>

                                    @if (Model != null && !string.IsNullOrEmpty(Model.Filename))
                                    {
                                        var tImg = (Model.Filename.StartsWith("/") || Model.Filename.StartsWith("http")) ? Model.Filename : ("/uploads/" + Model.Filename);
                                        <div class="mt-3 p-2 border rounded bg-light d-flex align-items-center gap-3">
                                            <img src="@tImg" alt="Current Photo" class="rounded-circle border shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='/assets/img/team-1.jpg';" />
                                            <div>
                                                <div class="small fw-bold text-dark">Current Photo</div>
                                                <div class="text-muted small">Choose a new file only to replace this image.</div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600" for="Status">Status</label>
                                    <select class="form-select" asp-for="Status" id="Status">
                                        <option value="1">Active</option>
                                        <option value="0">Inactive</option>
                                    </select>
                                    <span class="text-danger" asp-validation-for="Status"></span>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label f-w-600" for="Description">Bio / Role Summary (Optional)</label>
                                    <textarea class="form-control" asp-for="Description" id="Description" rows="3" placeholder="Brief intro about this trustee / team member"></textarea>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                                <a href="/Admin/Master/OurTeamDetailsList" class="btn btn-outline-secondary">
                                    <i class="fa fa-times me-1"></i> Cancel
                                </a>
                                <button class="btn btn-primary" type="submit">
                                    <i class="fa fa-save me-1"></i> @(isEdit ? "Update Team Member" : "Save Team Member")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Container-fluid Ends-->
</div>
