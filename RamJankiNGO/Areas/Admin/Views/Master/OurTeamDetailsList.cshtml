@model IEnumerable<RamJankiNGO.Models.TeamDetailsDto>
@{
    ViewData["Title"] = "Our Team Details List";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Trustees & Team Directory</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item">CMS Masters</li>
                        <li class="breadcrumb-item active">Our Team</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-user-friends text-primary me-2"></i> Trust Members & Officials (@(Model?.Count() ?? 0))</h5>
                        <a href="/Admin/Master/AddOurTeamDetails" class="btn btn-primary btn-sm">
                            <i class="fa fa-user-plus me-1"></i> Add Team Member
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 70px;">Sr. No.</th>
                                        <th class="text-center" style="width: 90px;">Photo</th>
                                        <th>Member Name</th>
                                        <th>Designation / Role</th>
                                        <th class="text-center" style="width: 100px;">Status</th>
                                        <th class="text-center" style="width: 130px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || !Model.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="fa fa-user-friends fa-2x text-muted mb-2 d-block opacity-50"></i>
                                                No team members found. Click "Add Team Member" to add trustees and officials.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int index = 1;
                                        foreach (var contact in Model)
                                        {
                                            var teamImg = string.IsNullOrEmpty(contact.Filename) 
                                                ? "/assets/img/team-1.jpg" 
                                                : (contact.Filename.StartsWith("/") || contact.Filename.StartsWith("http") 
                                                    ? contact.Filename 
                                                    : "/uploads/" + contact.Filename);

                                            <tr>
                                                <td class="text-center fw-bold">@index</td>
                                                <td class="text-center">
                                                    <img src="@teamImg" class="rounded-circle border shadow-sm" style="height: 55px; width: 55px; object-fit: cover;" alt="@contact.Name" onerror="this.src='/assets/img/team-1.jpg';" />
                                                </td>
                                                <td>
                                                    <div class="f-w-600 fs-6">@contact.Name</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border fs-6">
                                                        <i class="fa fa-briefcase me-1 text-muted"></i> @contact.Designation
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    @if (contact.Status == 1)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/Admin/Master/AddOurTeamDetails?id=@contact.TeamsId" class="btn btn-outline-primary" title="Edit">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a href="/Admin/Master/DeleteOurTeamDetails?id=@contact.TeamsId" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this team member?');">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
