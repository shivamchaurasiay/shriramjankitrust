@model IEnumerable<RamJankiNGO.Models.GalleryMasterDto>
@{
    ViewData["Title"] = "Gallery Master List";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Photo Albums & Categories</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item">CMS Masters</li>
                        <li class="breadcrumb-item active">Gallery Albums</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-folder-open text-primary me-2"></i> All Gallery Albums (@(Model?.Count() ?? 0))</h5>
                        <a href="/Admin/Master/AddGalleryMaster" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus me-1"></i> Add New Album
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-center" style="width: 70px;">Sr. No.</th>
                                        <th>Album / Category Name</th>
                                        <th class="text-center" style="width: 120px;">Status</th>
                                        <th class="text-center" style="width: 140px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || !Model.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="fa fa-folder fa-2x text-muted mb-2 d-block opacity-50"></i>
                                                No gallery albums found. Click "Add New Album" to create an album.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        int index = 1;
                                        foreach (var contact in Model)
                                        {
                                            <tr>
                                                <td class="text-center fw-bold">@index</td>
                                                <td>
                                                    <span class="f-w-600 fs-6">
                                                        <i class="fa fa-folder text-warning me-2"></i> @contact.GalleryName
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    @if (contact.Status == 1)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="/Admin/Master/AddGalleryMaster?id=@contact.GalleryMId" class="btn btn-outline-primary" title="Edit">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a href="/Admin/Master/DeleteGalleryMaster?id=@contact.GalleryMId" class="btn btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this album?');">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
