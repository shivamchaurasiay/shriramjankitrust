@model RamJankiNGO.Models.MemberImportResult
@{
    ViewData["Title"] = "Bulk Excel Member Import";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Bulk Excel Member Import</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index"><i data-feather="home"></i></a></li>
                        <li class="breadcrumb-item"><a href="/Admin/Member/Index">Members</a></li>
                        <li class="breadcrumb-item active">Import</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-8 col-lg-10 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-file-excel text-success me-2"></i> Upload Members Spreadsheet (.xlsx)</h5>
                        <a href="/Admin/Member/DownloadSampleTemplate" class="btn btn-outline-success btn-sm">
                            <i class="fa fa-download me-1"></i> Download Sample Excel Template
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle me-1"></i>
                            <strong>Guidelines:</strong> The uploaded Excel sheet must have column headers: <code>FullName*</code>, <code>Mobile*</code>, <code>Email</code>, <code>MemberType</code>, <code>Address</code>, <code>City</code>, <code>State</code>, <code>PinCode</code>.
                            Duplicate mobile numbers will be skipped automatically to prevent conflicting records.
                        </div>

                        <form method="post" action="/Admin/Member/Import" enctype="multipart/form-data" class="mt-4">
                            <div class="mb-3">
                                <label class="form-label f-w-600">Select Excel (.xlsx) File</label>
                                <input type="file" name="excelFile" class="form-control" accept=".xlsx" required />
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <a href="/Admin/Member/Index" class="btn btn-outline-secondary">Back to Members</a>
                                <button type="submit" class="btn btn-success"><i class="fa fa-upload me-1"></i> Start Import</button>
                            </div>
                        </form>

                        @if (Model != null && Model.TotalRows > 0)
                        {
                            <div class="mt-5 p-3 border rounded bg-light">
                                <h6 class="f-w-600 mb-3"><i class="fa fa-chart-bar me-1"></i> Import Results Summary</h6>
                                <div class="row text-center g-2 mb-3">
                                    <div class="col-3">
                                        <div class="p-2 bg-white rounded border">
                                            <div class="f-12 text-muted">Total Rows</div>
                                            <h5 class="mb-0">@Model.TotalRows</h5>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 bg-success text-white rounded">
                                            <div class="f-12">Imported</div>
                                            <h5 class="mb-0 text-white">@Model.SuccessCount</h5>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 bg-warning text-dark rounded">
                                            <div class="f-12">Duplicates Skipped</div>
                                            <h5 class="mb-0">@Model.SkippedCount</h5>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 bg-danger text-white rounded">
                                            <div class="f-12">Failed Rows</div>
                                            <h5 class="mb-0 text-white">@Model.FailedCount</h5>
                                        </div>
                                    </div>
                                </div>

                                @if (Model.Errors != null && Model.Errors.Count > 0)
                                {
                                    <h6 class="text-danger f-w-600">Row Notes & Issues:</h6>
                                    <ul class="text-danger f-12" style="max-height: 200px; overflow-y: auto;">
                                        @foreach (var err in Model.Errors)
                                        {
                                            <li>@err</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
