@model RamJankiNGO.Models.UserProfileDto
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
}

<style>
    .change-pwd-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid #e2e8f0;
        background: #ffffff;
    }
    .change-pwd-card .card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 18px 24px;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
    .user-info-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #eef7f6;
        border: 1px solid #c7e8e3;
        padding: 10px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        width: 100%;
    }
    .pwd-input-group {
        position: relative;
    }
    .pwd-input-group .form-control {
        padding-right: 42px;
        height: 44px;
        font-size: 14px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }
    .pwd-input-group .form-control:focus {
        border-color: #0b7268;
        box-shadow: 0 0 0 3px rgba(11, 114, 104, 0.15);
    }
    .pwd-toggle-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #6b7280;
        cursor: pointer;
        padding: 4px 6px;
        font-size: 16px;
        line-height: 1;
        z-index: 5;
    }
    .pwd-toggle-btn:hover {
        color: #111827;
    }
    .strength-meter-bar {
        height: 4px;
        border-radius: 2px;
        background: #e5e7eb;
        margin-top: 6px;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .strength-meter-fill {
        height: 100%;
        width: 0%;
        transition: all 0.3s ease;
    }
    .validation-feedback {
        font-size: 12px;
        margin-top: 4px;
        font-weight: 500;
        min-height: 18px;
    }
</style>

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h3 class="fw-bold">Security Settings</h3>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Admin/Dashboard/Index">
                                <svg class="stroke-icon">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                            </a>
                        </li>
                        <li class="breadcrumb-item">Account</li>
                        <li class="breadcrumb-item active">Change Password</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- Container-fluid starts-->
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10 col-md-12">
                <div class="card change-pwd-card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="mb-1 text-dark fw-bold"><i class="fa fa-key text-primary me-2"></i>Change Password</h4>
                            <p class="text-muted mb-0 font-roboto" style="font-size: 13px;">Manage your account security and update your login password.</p>
                        </div>
                    </div>
                    <div class="card-body p-4">

                        <!-- User Info Bar -->
                        <div class="user-info-badge">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: bold;">
                                <i class="fa fa-user-shield"></i>
                            </div>
                            <div>
                                <span class="d-block text-muted" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Logged in Account</span>
                                <strong class="text-dark" style="font-size: 14px;">@(string.IsNullOrEmpty(Model?.UserName) ? "Administrator" : Model.UserName)</strong>
                            </div>
                        </div>

                        <!-- Alerts -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                                <i class="fa fa-check-circle me-2 fs-5"></i>
                                <div><strong>Success!</strong> @TempData["SuccessMessage"]</div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                                <i class="fa fa-exclamation-triangle me-2 fs-5"></i>
                                <div><strong>Error!</strong> @TempData["ErrorMessage"]</div>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <form id="changePasswordForm" method="post" action="/Admin/Dashboard/ChangePassword" novalidate>
                            
                            <!-- 1. Old / Current Password -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark" for="oldPassword">
                                    Current Password (पुराना पासवर्ड) <span class="text-danger">*</span>
                                </label>
                                <div class="pwd-input-group">
                                    <input type="password" 
                                           class="form-control" 
                                           id="oldPassword" 
                                           name="oldPassword" 
                                           placeholder="Enter your current password" 
                                           required 
                                           autocomplete="current-password" />
                                    <button type="button" class="pwd-toggle-btn" onclick="togglePassword('oldPassword', 'toggleOldIcon')" title="Show/Hide Password" tabindex="-1">
                                        <i class="fa fa-eye" id="toggleOldIcon"></i>
                                    </button>
                                </div>
                                <div class="text-danger validation-feedback" id="oldPasswordError"></div>
                            </div>

                            <!-- 2. New Password -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark" for="newPassword">
                                    New Password (नया पासवर्ड) <span class="text-danger">*</span>
                                </label>
                                <div class="pwd-input-group">
                                    <input type="password" 
                                           class="form-control" 
                                           id="newPassword" 
                                           name="newPassword" 
                                           placeholder="Enter a new password (min. 6 characters)" 
                                           minlength="6" 
                                           required 
                                           autocomplete="new-password" />
                                    <button type="button" class="pwd-toggle-btn" onclick="togglePassword('newPassword', 'toggleNewIcon')" title="Show/Hide Password" tabindex="-1">
                                        <i class="fa fa-eye" id="toggleNewIcon"></i>
                                    </button>
                                </div>
                                <div class="strength-meter-bar">
                                    <div class="strength-meter-fill" id="strengthFill"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-muted validation-feedback" id="strengthText" style="font-size: 11px;">Password strength: Empty</div>
                                    <div class="text-danger validation-feedback" id="newPasswordError"></div>
                                </div>
                            </div>

                            <!-- 3. Confirm New Password -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark" for="confirmPassword">
                                    Confirm New Password (पासवर्ड की पुष्टि करें) <span class="text-danger">*</span>
                                </label>
                                <div class="pwd-input-group">
                                    <input type="password" 
                                           class="form-control" 
                                           id="confirmPassword" 
                                           name="confirmPassword" 
                                           placeholder="Re-enter the new password" 
                                           required 
                                           autocomplete="new-password" />
                                    <button type="button" class="pwd-toggle-btn" onclick="togglePassword('confirmPassword', 'toggleConfirmIcon')" title="Show/Hide Password" tabindex="-1">
                                        <i class="fa fa-eye" id="toggleConfirmIcon"></i>
                                    </button>
                                </div>
                                <div class="validation-feedback" id="confirmPasswordError"></div>
                            </div>

                            <!-- Form Actions -->
                            <div class="d-flex align-items-center gap-3 pt-3 border-top">
                                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" id="submitBtn">
                                    <i class="fa fa-shield-alt me-2"></i>Update Password
                                </button>
                                <a href="/Admin/Dashboard/Index" class="btn btn-outline-secondary px-4 py-2">
                                    Cancel
                                </a>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Eye Toggle for Password Fields
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!input || !icon) return;

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('changePasswordForm');
        const oldPwd = document.getElementById('oldPassword');
        const newPwd = document.getElementById('newPassword');
        const confirmPwd = document.getElementById('confirmPassword');

        const oldError = document.getElementById('oldPasswordError');
        const newError = document.getElementById('newPasswordError');
        const confirmError = document.getElementById('confirmPasswordError');

        const strengthFill = document.getElementById('strengthFill');
        const strengthText = document.getElementById('strengthText');

        // Realtime Password Strength Calculation
        newPwd.addEventListener('input', function () {
            const val = newPwd.value;
            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/\d/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (val.length === 0) {
                strengthFill.style.width = '0%';
                strengthFill.style.backgroundColor = '#e5e7eb';
                strengthText.textContent = 'Password strength: Empty';
                strengthText.style.color = '#6b7280';
                newError.textContent = '';
            } else if (val.length < 6) {
                strengthFill.style.width = '25%';
                strengthFill.style.backgroundColor = '#ef4444';
                strengthText.textContent = 'Password strength: Too Short (min. 6 characters)';
                strengthText.style.color = '#ef4444';
                newError.textContent = 'Must be at least 6 characters.';
            } else if (score <= 2) {
                strengthFill.style.width = '50%';
                strengthFill.style.backgroundColor = '#f59e0b';
                strengthText.textContent = 'Password strength: Fair';
                strengthText.style.color = '#f59e0b';
                newError.textContent = '';
            } else if (score <= 4) {
                strengthFill.style.width = '75%';
                strengthFill.style.backgroundColor = '#3b82f6';
                strengthText.textContent = 'Password strength: Good';
                strengthText.style.color = '#3b82f6';
                newError.textContent = '';
            } else {
                strengthFill.style.width = '100%';
                strengthFill.style.backgroundColor = '#10b981';
                strengthText.textContent = 'Password strength: Strong';
                strengthText.style.color = '#10b981';
                newError.textContent = '';
            }

            // Also revalidate confirm password if it has value
            if (confirmPwd.value.length > 0) {
                validateConfirmPassword();
            }
        });

        // Realtime Confirm Password Match Check
        function validateConfirmPassword() {
            if (confirmPwd.value.length === 0) {
                confirmError.textContent = '';
                confirmPwd.style.borderColor = '#d1d5db';
                return true;
            }
            if (confirmPwd.value !== newPwd.value) {
                confirmError.textContent = '✖ Passwords do not match!';
                confirmError.className = 'validation-feedback text-danger';
                confirmPwd.style.borderColor = '#ef4444';
                return false;
            } else {
                confirmError.textContent = '✔ Passwords match!';
                confirmError.className = 'validation-feedback text-success';
                confirmPwd.style.borderColor = '#10b981';
                return true;
            }
        }

        confirmPwd.addEventListener('input', validateConfirmPassword);

        // Form Submit Validation
        form.addEventListener('submit', function (e) {
            let isValid = true;

            // Check old password
            if (!oldPwd.value.trim()) {
                oldError.textContent = 'Please enter your current password.';
                oldPwd.focus();
                isValid = false;
            } else {
                oldError.textContent = '';
            }

            // Check new password
            if (!newPwd.value) {
                newError.textContent = 'Please enter a new password.';
                if (isValid) newPwd.focus();
                isValid = false;
            } else if (newPwd.value.length < 6) {
                newError.textContent = 'New password must be at least 6 characters long.';
                if (isValid) newPwd.focus();
                isValid = false;
            } else if (newPwd.value === oldPwd.value) {
                newError.textContent = 'New password cannot be the same as your current password.';
                if (isValid) newPwd.focus();
                isValid = false;
            }

            // Check confirm password
            if (!confirmPwd.value) {
                confirmError.textContent = 'Please confirm your new password.';
                confirmError.className = 'validation-feedback text-danger';
                if (isValid) confirmPwd.focus();
                isValid = false;
            } else if (newPwd.value !== confirmPwd.value) {
                confirmError.textContent = '✖ Passwords do not match!';
                confirmError.className = 'validation-feedback text-danger';
                if (isValid) confirmPwd.focus();
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
            }
        });
    });
</script>
