@model RamJankiNGO.Models.DonationDto
@using System.Data
@{
    ViewData["Title"] = "Record Offline Donation";
    Layout = "~/Areas/Admin/Views/Shared/_adminLayout.cshtml";
    var campaigns = ViewBag.Campaigns as DataTable;
    var members = ViewBag.Members as DataTable;
}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-6">
                    <h4>Record Offline Donation</h4>
                </div>
                <div class="col-6">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index"><i data-feather="home"></i></a></li>
                        <li class="breadcrumb-item"><a href="/Admin/Donation/Index">Donations</a></li>
                        <li class="breadcrumb-item active">Offline Entry</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-9 col-lg-11 mx-auto">
                <div class="card shadow-sm border-0">
                    <div class="card-header pb-0">
                        <h5 class="f-w-600 mb-0"><i class="fa fa-cash-register text-danger me-2"></i> Authorized Offline Donation Entry</h5>
                        <p class="text-muted f-12 mt-1 mb-0">Record cash, cheque, bank deposit, or direct UPI payments. An official numbered receipt is generated immediately.</p>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/Admin/Donation/AddOffline">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Link Existing Member (Optional)</label>
                                    <select asp-for="MemberId" class="form-select" id="memberSelect" onchange="fillMemberInfo(this)">
                                        <option value="">-- Non-member / Guest Donor --</option>
                                        @if (members != null)
                                        {
                                            foreach (DataRow m in members.Rows)
                                            {
                                                <option value="@m["MemberId"]" data-name="@m["FullName"]" data-phone="@m["Mobile"]" data-email="@m["Email"]">
                                                    @m["FullName"] (@m["MemberCode"] - @m["Mobile"])
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Select Cause / Campaign</label>
                                    <select asp-for="CampaignId" class="form-select">
                                        <option value="">General Donation Fund</option>
                                        @if (campaigns != null)
                                        {
                                            foreach (DataRow c in campaigns.Rows)
                                            {
                                                <option value="@c["CampaignId"]">@c["Title"]</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Donor Full Name <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="DonorName" id="donorName" class="form-control" required placeholder="Name of Donor" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Donor Mobile <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="DonorPhone" id="donorPhone" class="form-control" required placeholder="Mobile Number" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Donor Email</label>
                                    <input type="email" asp-for="DonorEmail" id="donorEmail" class="form-control" placeholder="Email Address" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label f-w-600">Donor PAN (Optional for 80G)</label>
                                    <input type="text" asp-for="DonorPan" class="form-control" placeholder="e.g. ABCDE1234F" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label f-w-600">Donation Amount (INR) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="number" step="1" asp-for="Amount" class="form-control" required placeholder="Amount in ₹" min="1" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label f-w-600">Payment Mode <span class="text-danger">*</span></label>
                                    <select asp-for="PaymentMode" class="form-select" required>
                                        <option value="Cash">Cash</option>
                                        <option value="Cheque">Cheque</option>
                                        <option value="Bank Transfer">Bank Transfer (NEFT/RTGS/IMPS)</option>
                                        <option value="UPI">Direct UPI / QR</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label f-w-600">Instrument / Txn Ref</label>
                                    <input type="text" asp-for="PaymentGatewayReference" class="form-control" placeholder="Cheque No / UTR / Txn ID" />
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label f-w-600">Donor Address</label>
                                    <input type="text" asp-for="DonorAddress" class="form-control" placeholder="Address, City, State" />
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label f-w-600">Remarks / Purpose Notes</label>
                                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Specific intention, seva, or background note"></textarea>
                                </div>
                            </div>

                            <div class="mt-4 d-flex justify-content-end gap-2">
                                <a href="/Admin/Donation/Index" class="btn btn-outline-secondary">Cancel</a>
                                <button type="submit" class="btn btn-danger"><i class="fa fa-receipt me-1"></i> Confirm & Generate Receipt</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillMemberInfo(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.value) {
            document.getElementById("donorName").value = opt.getAttribute("data-name") || "";
            document.getElementById("donorPhone").value = opt.getAttribute("data-phone") || "";
            document.getElementById("donorEmail").value = opt.getAttribute("data-email") || "";
        }
    }
</script>
}
